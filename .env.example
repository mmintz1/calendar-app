# ---- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on your OAuth client.
# Local dev:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Production (example): https://your-app.vercel.app/api/auth/callback

# ---- Booking owner ----
# Only this Google account is allowed to connect as the bookable calendar.
OWNER_EMAIL=you@example.com

# ---- Calendar / booking rules ----
CALENDAR_ID=primary
TIMEZONE=America/New_York
BOOKING_START_HOUR=9
BOOKING_END_HOUR=17
SLOT_MINUTES=30

# ---- Upstash Redis (token store) ----
# Create via Vercel dashboard → Storage → Redis (Upstash), or directly at
# upstash.com. Pull Vercel-managed values locally with:
#   vercel env pull .env.local
# The app accepts either of these naming conventions:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel's integration may instead inject KV_REST_API_URL / KV_REST_API_TOKEN,
#  which are also supported.)
